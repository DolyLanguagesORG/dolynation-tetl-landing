---
import { trailWords } from '../data/landing';

/**
 * Huellas del camino: posiciones en % del ancho del stage. Se omite la zona
 * central donde está el libro. Cada 2 huellas se coloca una palabra.
 */
const prints: { x: number; up: boolean; word?: string }[] = [];
let w = 0;
for (let i = 0; i < 26; i++) {
  const x = 2 + i * 3.85;
  if (x > 36 && x < 64) continue;
  const up = i % 2 === 0;
  const word = up ? trailWords[w++ % trailWords.length] : undefined;
  prints.push({ x, up, word });
}
---

<div class="doly-stage pointer-events-none absolute inset-0" data-doly-stage aria-hidden="true">
  <!-- camino -->
  <div class="path-wrap absolute inset-x-0" style="top: var(--ground-y)">
    <div class="path-line" data-path-line></div>
    <div class="path-ticks" data-path-ticks></div>
  </div>

  <!-- huellas + palabras (rastro de aprendizaje) -->
  <div class="absolute inset-x-0" style="top: var(--ground-y)">
    {
      prints.map((p) => (
        <div class="trail-print" data-print data-x={p.x} style={`left:${p.x}%;`}>
          <svg viewBox="0 0 24 20" class={`paw ${p.up ? 'paw--up' : 'paw--down'}`}>
            <ellipse cx="9" cy="10" rx="5.2" ry="4.4" />
            <circle cx="16" cy="4.2" r="2.1" />
            <circle cx="18.6" cy="9" r="2.1" />
            <circle cx="16.2" cy="14.4" r="2.1" />
            <circle cx="13" cy="2.6" r="1.6" opacity="0" />
          </svg>
          {p.word && <span class="trail-word">{p.word}</span>}
        </div>
      ))
    }
  </div>

  <!-- ancla dimensional para calcular la escala responsiva en el canvas -->
  <div class="doly-anchor pointer-events-none opacity-0" data-anchor></div>

  <!-- Doly + Libro (3 GIFs completos renderizados sobre canvas y controlados con GSAP) -->
  <canvas class="absolute inset-0 z-20 h-full w-full" data-doly-canvas></canvas>
</div>

<style>
  .doly-anchor {
    position: absolute;
    left: 50%;
    width: var(--anchor-w);
    aspect-ratio: 375 / 321;
    top: calc(var(--ground-y) - var(--anchor-w) * var(--anchor-ground));
    transform: translateX(-50%);
  }
  .path-line {
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, transparent, var(--color-ink-500) 8%, var(--color-ink-500) 92%, transparent);
    transform-origin: left center;
  }
  .path-ticks {
    margin-top: 6px;
    height: 5px;
    width: 100%;
    background-image: repeating-linear-gradient(90deg, var(--color-ink-700) 0 1px, transparent 1px 64px);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    transform-origin: left center;
  }
  .trail-print {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .paw {
    width: 15px;
    height: 13px;
    fill: var(--color-ink-500);
  }
  .paw--up {
    transform: translateY(9px);
  }
  .paw--down {
    transform: translateY(17px);
  }
  .trail-word {
    position: absolute;
    left: 50%;
    top: 34px;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-ink-400);
  }
</style>
