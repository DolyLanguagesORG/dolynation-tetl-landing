---
import RichTitle from './RichTitle.astro';
import { chapters } from '../data/landing';
---

{
  chapters.map((c) => (
    <article
      class={`chapter pointer-events-none absolute inset-x-0 top-[13svh] z-40 mx-auto flex w-full max-w-6xl px-6 md:px-10 ${
        c.align === 'right' ? 'justify-end text-right' : 'justify-start text-left'
      }`}
      data-chapter={c.id}
      data-window={c.window.join(',')}
      aria-label={c.eyebrow}
    >
      <div class="relative max-w-xl">
        <span
          class={`chapter-index pointer-events-none absolute -top-[0.32em] font-serif italic leading-none text-transparent ${
            c.align === 'right' ? 'right-full mr-6' : 'left-full ml-6'
          } hidden md:block`}
          data-chapter-index
        >
          {c.index}
        </span>
        <p
          class={`mb-5 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.28em] text-ink-400 ${
            c.align === 'right' ? 'justify-end' : ''
          }`}
        >
          <span data-chapter-num>{c.index}</span>
          <span class="chapter-rule block h-px w-10 bg-ink-500" data-chapter-rule />
          <span data-chapter-eyebrow>{c.eyebrow}</span>
        </p>
        <RichTitle
          text={c.title}
          as="h2"
          class="chapter-title text-balance font-medium leading-[1.05] tracking-[-0.03em] text-ink-100"
        />
        <p class="mt-5 text-base leading-relaxed text-ink-300 md:text-lg" data-chapter-body>
          {c.body}
        </p>
      </div>
    </article>
  ))
}

<style>
  .chapter {
    visibility: hidden;
  }
  .chapter :global(.chapter-title) {
    font-size: clamp(1.9rem, min(4.4vw, 7svh), 4rem);
  }
  .chapter-index {
    font-size: clamp(6rem, 14vw, 13rem);
    -webkit-text-stroke: 1px var(--color-ink-700);
  }
  .chapter-rule {
    transform-origin: left center;
  }
</style>
