---
import RichTitle from './RichTitle.astro';
import { storySections } from '../data/landing';
---

<!-- Indicador flotante de pasos del recorrido (sincronizado con los pasos de Doly) -->
<div
  class="pointer-events-auto absolute bottom-[3.2svh] left-1/2 z-40 flex -translate-x-1/2 items-center gap-1.5 rounded-full border border-ink-700/80 bg-ink-950/85 px-3 py-1.5 backdrop-blur-md"
  data-step-bar
>
  <button
    type="button"
    class="step-pill is-active font-mono text-[10px] uppercase tracking-[0.18em]"
    data-step-btn="0"
  >
    00 · Inicio
  </button>
  {
    storySections.map((s, idx) => (
      <button
        type="button"
        class="step-pill font-mono text-[10px] uppercase tracking-[0.18em]"
        data-step-btn={idx + 1}
      >
        {s.index} · {s.navLabel}
      </button>
    ))
  }
</div>

{
  storySections.map((s, idx) => (
    <article
      class="chapter pointer-events-none absolute inset-x-0 top-[10.5svh] z-40 mx-auto w-full max-w-7xl px-6 md:px-10"
      data-chapter={s.id}
      data-section-index={idx + 1}
      aria-label={s.eyebrow}
    >
      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12 lg:gap-10">
        <!-- Columna izquierda: Encabezado editorial de la sección -->
        <div class="lg:col-span-5">
          <div class="mb-3 flex flex-wrap items-center gap-3">
            <span class="rounded-full border border-ink-600 bg-ink-950/70 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.2em] text-ink-300">
              {s.waypointLabel}
            </span>
          </div>

          <p class="mb-3 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.26em] text-ink-400">
            <span class="text-ink-200">{s.index}</span>
            <span class="chapter-rule block h-px w-8 bg-ink-500" data-chapter-rule />
            <span>{s.eyebrow}</span>
          </p>

          <RichTitle
            text={s.title}
            as="h2"
            class="chapter-title text-balance font-medium leading-[1.06] tracking-[-0.03em] text-ink-100"
          />

          <p class="mt-3.5 text-sm leading-relaxed text-ink-300 md:text-base" data-chapter-body>
            {s.lead}
          </p>

          {s.badge && (
            <div
              class="mt-4 inline-flex items-center gap-2 rounded-lg border border-ink-700 bg-ink-950/60 px-3.5 py-2 font-mono text-[11px] tracking-[0.12em] text-ink-200"
              data-chapter-card
            >
              <span class="h-1.5 w-1.5 rounded-full bg-ink-100" />
              {s.badge}
            </div>
          )}
        </div>

        <!-- Columna derecha: Tarjetas o tabla comparativa de la sección -->
        <div class="lg:col-span-7">
          {s.cards && (
            <div
              class={`grid gap-3.5 ${
                s.cards.length === 4
                  ? 'grid-cols-1 sm:grid-cols-2'
                  : s.cards.length === 3
                    ? 'grid-cols-1 md:grid-cols-3'
                    : 'grid-cols-1 sm:grid-cols-2'
              }`}
            >
              {s.cards.map((card) => (
                <div
                  class="chapter-card rounded-xl border border-ink-700/80 bg-ink-950/75 p-4 backdrop-blur-sm"
                  data-chapter-card
                >
                  <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400">{card.tag}</span>
                  <h3 class="mt-1.5 text-base font-semibold tracking-tight text-ink-100">{card.title}</h3>
                  <p class="mt-1.5 text-xs leading-relaxed text-ink-300 md:text-sm">{card.description}</p>
                </div>
              ))}
            </div>
          )}

          {s.comparisons && (
            <div class="space-y-2.5">
              <div class="grid grid-cols-12 gap-3 px-3 font-mono text-[10px] uppercase tracking-[0.22em] text-ink-400">
                <span class="col-span-6">Apps Tradicionales</span>
                <span class="col-span-6 text-ink-100">DolyNation · Dolynglish</span>
              </div>
              {s.comparisons.map((row) => (
                <div
                  class="chapter-card grid grid-cols-1 gap-2 rounded-xl border border-ink-700/80 bg-ink-950/75 p-3.5 backdrop-blur-sm sm:grid-cols-12 sm:gap-4"
                  data-chapter-card
                >
                  <div class="text-xs leading-relaxed text-ink-400 line-through decoration-ink-600 sm:col-span-6 md:text-sm">
                    {row.traditional}
                  </div>
                  <div class="border-t border-ink-800 pt-2 text-xs font-medium leading-relaxed text-ink-100 sm:col-span-6 sm:border-t-0 sm:border-l sm:pl-4 sm:pt-0 md:text-sm">
                    {row.dolynation}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </article>
  ))
}

<style>
  .chapter {
    visibility: hidden;
    opacity: 0;
  }
  .chapter :global(.chapter-title) {
    font-size: clamp(1.55rem, min(3.1vw, 5.2svh), 2.75rem);
  }
  .chapter-rule {
    transform-origin: left center;
  }
  .step-pill {
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    color: var(--color-ink-400);
    transition:
      color 0.3s ease,
      background-color 0.3s ease;
    cursor: pointer;
  }
  .step-pill:hover {
    color: var(--color-ink-200);
  }
  .step-pill.is-active {
    background: var(--color-ink-100);
    color: var(--color-ink-950);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .step-pill {
      padding: 0.22rem 0.45rem;
      font-size: 9px;
    }
  }
</style>
