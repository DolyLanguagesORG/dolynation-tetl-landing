---
/**
 * Libro abierto en SVG, dibujado en el mismo sistema de coordenadas que el
 * recorte de la ilustración original (375 x 321) para que el cross-fade
 * hacia la pose final de Doly coincida.
 */
const SPINE_X = 187;
const TL = [78, 172];
const BL = [42, 270];
const SPINE_TOP = 236;
const SPINE_BOTTOM = 300;

const mirror = (x: number) => SPINE_X * 2 - x;

function halfPath(k: number, side: 'left' | 'right') {
  const tlx = TL[0] - 7 * k;
  const tly = TL[1] + 5 * k + (side === 'right' ? 8 : 0);
  const blx = BL[0] - 7 * k;
  const bly = BL[1] + 6 * k + (side === 'right' ? 2 : 0);
  const sy = SPINE_BOTTOM + 3.5 * k;
  const c1x = 95 - 6 * k;
  const c1y = 268 + 6 * k;
  const c2x = 150;
  const c2y = 280 + 4 * k;
  const X = (x: number) => (side === 'left' ? x : mirror(x));
  return [
    `M${X(tlx)},${tly}`,
    `C${X(120 - 4 * k)},${tly + 2} ${X(162)},${SPINE_TOP - 44 + 4 * k} ${X(SPINE_X)},${SPINE_TOP + 4 * k}`,
    `L${X(SPINE_X)},${sy}`,
    `C${X(c2x)},${c2y} ${X(c1x)},${c1y} ${X(blx)},${bly}`,
    'Z',
  ].join(' ');
}

const layers = [3, 2, 1];
---

<svg
  viewBox="0 0 375 321"
  class="open-book absolute inset-0 h-full w-full overflow-visible"
  aria-hidden="true"
  data-book
>
  {
    (['left', 'right'] as const).map((side) => (
      <g data-book-half={side}>
        <path d={halfPath(3, side)} fill="#0a0a0a" stroke="#0a0a0a" stroke-width="11" stroke-linejoin="round" />
        {layers.map((k) => (
          <path d={halfPath(k, side)} fill="#f4f4f2" stroke="#0a0a0a" stroke-width="3" stroke-linejoin="round" />
        ))}
        <path d={halfPath(0, side)} fill="#f4f4f2" stroke="#0a0a0a" stroke-width="3.2" stroke-linejoin="round" />
        {/* líneas de texto muy sutiles */}
        {[0, 1, 2, 3].map((i) => {
          const y = 196 + i * 16 + (side === 'right' ? 8 : 0);
          const x1 = side === 'left' ? 84 - i * 6 : mirror(84 - i * 6);
          const x2 = side === 'left' ? 168 - i * 2 : mirror(168 - i * 2);
          return <path d={`M${x1},${y + i * 2} Q${(x1 + x2) / 2},${y - 4 + i * 2} ${x2},${y + 10 + i * 4}`} stroke="#cfcfcb" stroke-width="2" fill="none" stroke-linecap="round" />;
        })}
      </g>
    ))
  }
  <line x1={SPINE_X} y1={SPINE_TOP} x2={SPINE_X} y2={SPINE_BOTTOM} stroke="#0a0a0a" stroke-width="2.4" data-book-spine />
</svg>
