---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Stage3D from '../components/Stage3D.astro';
import HeroTitle from '../components/HeroTitle.astro';
import StoryChapters from '../components/StoryChapters.astro';
import DolyStage from '../components/DolyStage.astro';
import FinalCta from '../components/FinalCta.astro';
import { STORY_HEIGHT_VH } from '../scripts/timeline/beats';
---

<Layout>
  <SiteHeader />
  <Stage3D />

  <main>
    <!-- Pista de scroll para la experiencia 3D Scrollytelling dividida por secciones -->
    <section
      id="story-track"
      class="relative w-full"
      style={`height: ${STORY_HEIGHT_VH}svh;`}
      aria-label="Recorrido interactivo DolyNation"
    >
      <!-- Anclas de posición para las 4 secciones principales del recorrido -->
      <div id="sec-problema" class="pointer-events-none absolute inset-x-0" style="top: 18%;"></div>
      <div id="sec-que-es" class="pointer-events-none absolute inset-x-0" style="top: 38%;"></div>
      <div id="sec-por-que" class="pointer-events-none absolute inset-x-0" style="top: 58%;"></div>
      <div id="sec-funcionalidades" class="pointer-events-none absolute inset-x-0" style="top: 76%;"></div>

      <div id="story-stage" class="sticky top-0 h-svh w-full overflow-hidden">
        <HeroTitle />
        <StoryChapters />
        <DolyStage />
      </div>
    </section>

    <FinalCta />
  </main>
</Layout>

<script>
  import { SmoothScroll } from '../scripts/core/SmoothScroll';
  import { SceneController } from '../scripts/scene/SceneController';
  import { MasterTimeline } from '../scripts/timeline/MasterTimeline';

  let smoothScroll: SmoothScroll | undefined;
  let sceneController: SceneController | undefined;
  let masterTimeline: MasterTimeline | undefined;

  function boot() {
    smoothScroll = new SmoothScroll();

    const webglCanvas = document.querySelector<HTMLCanvasElement>('[data-webgl-canvas]');
    if (webglCanvas) {
      sceneController = new SceneController(webglCanvas);
    }

    const track = document.getElementById('story-track');
    const stage = document.getElementById('story-stage');
    if (track && stage) {
      masterTimeline = new MasterTimeline(track, stage, sceneController);
      masterTimeline.init();
    }
  }

  boot();

  document.addEventListener('astro:before-swap', () => {
    masterTimeline?.destroy();
    sceneController?.dispose();
    smoothScroll?.destroy();
  });
</script>
